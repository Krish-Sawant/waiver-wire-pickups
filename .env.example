# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Auth ---
# Signs session tokens. MUST be set in production so logins survive a restart.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=

# --- User database (SQLite) ---
# Where the users table lives. Default is ./waiverwire.db (fine for local dev).
# On the server, point this at a persistent, backed-up location, e.g.:
#   USERS_DB=/var/lib/waiverwire/waiverwire.db
USERS_DB=waiverwire.db

# --- Gemini (Fantasy Outlook / Waiver Assistant / Compare) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- CORS ---
# Extra browser origins allowed to call the API, comma-separated. Not needed
# when the frontend is served from the same origin as /api (the CloudFront
# setup). Example for a separate frontend host:
#   ALLOWED_ORIGINS=https://dxxxx.cloudfront.net
ALLOWED_ORIGINS=

# --- CLI helpers only (waiverwire.sleeper / waiverwire.waiver __main__) ---
# The web app reads each user's Sleeper name from the DB, not from here.
sleeper_username=
